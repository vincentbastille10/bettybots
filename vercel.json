{
  "version": 2,
  "builds": [
    { "src": "app.py", "use": "@vercel/python" },
    { "src": "static/**/*", "use": "@vercel/static" }
  ],
  "functions": {
    "app.py": {
      "runtime": "python3.11",
      "includeFiles": "templates/**,static/**"
    }
  },
  "routes": [
    { "src": "^/static/(.*)$", "dest": "/static/$1" },
    { "src": "^/favicon\\.ico$", "dest": "/favicon.ico" },
    { "src": "^/api/(.*)$", "dest": "/app.py" },
    { "src": "^/dashboard$", "dest": "/app.py" },
    { "src": "^/preview$", "dest": "/app.py" },
    { "src": "^/pay$", "dest": "/app.py" },
    { "src": "^/confirm$", "dest": "/app.py" },
    { "src": "^/chat$", "dest": "/app.py" },
    { "src": "^/embed/.*$", "dest": "/app.py" },
    { "src": ".*", "dest": "/app.py" }
  ]
}
