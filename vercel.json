{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/pay", "destination": "/api/index" },
    { "source": "/success", "destination": "/api/index" },
    { "source": "/cancel", "destination": "/api/index" },
    { "source": "/", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
